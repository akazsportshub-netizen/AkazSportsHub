# AKAZ Sports Hub API — copy to .env and fill in. Never commit the real .env.

NODE_ENV=development
PORT=3000

# --- Data stores (these defaults match docker-compose.yml) --------------------
POSTGRES_USER=akaz
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=akaz
DATABASE_URL=postgres://akaz:change-me-locally@localhost:5432/akaz
REDIS_URL=redis://localhost:6379

# --- Auth ---------------------------------------------------------------------
# Signing key for access tokens, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# --- URLs ---------------------------------------------------------------------
# Public origin of this API. Payment providers send webhooks to
#   <PUBLIC_BASE_URL>/v1/webhooks/tap  and  <PUBLIC_BASE_URL>/v1/webhooks/checkout
PUBLIC_BASE_URL=http://localhost:3000
# Where the payment page returns the customer (app deep link or a web page).
PAYMENT_RETURN_URL=akaz://payment-complete

# --- Bookings -----------------------------------------------------------------
# Length of the split-pay soft hold, in minutes.
HOLD_MINUTES=15
# Set to false on API-only replicas; at least one process must run the workers.
RUN_WORKERS=true

# --- Payments -----------------------------------------------------------------
# mock (local only, no money moves) | tap | checkout
PAYMENT_PROVIDER=mock

# Tap Payments: secret API key (sk_test_… / sk_live_…). Also signs Tap's webhooks.
TAP_SECRET_KEY=

# Checkout.com: secret key, the webhook signature key, and the processing channel id.
CHECKOUT_SECRET_KEY=
CHECKOUT_WEBHOOK_SECRET=
CHECKOUT_PROCESSING_CHANNEL_ID=
# Sandbox by default. Live accounts use https://<your-prefix>.api.checkout.com
CHECKOUT_API_BASE=https://api.sandbox.checkout.com
